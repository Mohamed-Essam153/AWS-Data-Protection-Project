# Copy to config.env (git ignores it) and fill in. Read by every script in scripts/.

AWS_REGION=us-east-1

# 4-8 lowercase letters/digits, same for the whole team. Bucket names use it, so it
# has to be globally unique - something like your initials plus two digits.
SUFFIX=changeme

# Who gets SNS security alerts and budget alerts. You must click the confirmation
# link AWS emails you after the first deploy.
ALERT_EMAIL=you@example.com

# Goes into the Owner tag on every resource.
OWNER=your-name

MONTHLY_BUDGET_USD=20

# Optional pieces that cost money. Turn them on for the week that needs them and for
# the demo, then back off (re-run scripts/deploy.sh after changing them).
ENABLE_RDS=false
# PostgreSQL 17 minor version for RDS. If deploy fails on it, see docs/troubleshooting.md
RDS_ENGINE_VERSION=17.6
ENABLE_WAF=false
ENABLE_MACIE=false
ENABLE_GUARDDUTY=false

# Set to false if the account already has an account-level Access Analyzer here.
CREATE_ACCESS_ANALYZER=true

# Leave empty to use the role you are signed in with for both. To show real
# separation of duties, put two different role ARNs here.
KEY_ADMIN_ROLE_ARN=
KEY_USER_ROLE_ARN=
